{
  "name": "vue3-ts-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vue-tsc -b && vite build --mode prod",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,vue,tsx}\" --fix",
    "format": "prettier --write src/**/*.{js,ts,vue,tsx,scss,css,json}",
    "prepare": "husky install",
    "commit": "git-cz"
  },
  "_comments": {
    "scripts": {
      "dev": "启动开发服务器",
      "build": "构建生产包",
      "test": "运行测试",
      "test:coverage": "运行测试并生成覆盖率报告",
      "test:ui": "运行测试并在交互式 UI 中查看结果",
      "preview": "本地预览构建结果",
      "lint": "运行 lint",
      "format": "使用 prettier 格式化代码",
      "commit": "使用 cz-customizable commit 规范化 commit",
      "prepare": "设置 commit 前先设置 husky"
    }
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.0.0-rc.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.20.1",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "sass": "^1.84.0",
    "typescript": "^5.3.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
